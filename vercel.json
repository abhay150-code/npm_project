{
  "version": 2,
  "builds": [
    {
      "src": "student-management-api/src/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["student-management-api/public/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "student-management-api/src/index.js"
    }
  ]
}
